{
  "name": "lambda-outbound-proxy",
  "version": "0.0.14",
  "description": "AWS Lambda HTTP proxy with response streaming that forwards SigV4-signed requests verbatim",
  "type": "module",
  "main": "dist/lambda-outbound-proxy.mjs",
  "module": "dist/lambda-outbound-proxy.mjs",
  "types": "dist/lambda-outbound-proxy.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lambda-outbound-proxy.d.ts",
      "import": "./dist/lambda-outbound-proxy.mjs"
    },
    "./proxy-request-handler.mjs": {
      "types": "./dist/proxy-request-handler.d.mts",
      "import": "./dist/proxy-request-handler.mjs"
    },
    "./fetch-proxy.js": {
      "types": "./dist/fetch-proxy.d.ts",
      "import": "./dist/fetch-proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ts:check": "tsc --noEmit",
    "lint": "eslint src test --fix",
    "pretty": "prettier -u --write \"**/*\" --log-level warn",
    "build:bundle": "rollup -c rollup.config.mjs",
    "build": "npm run ts:check && BUILD_BUMP=1 npm run build:bundle",
    "test": "npm run build:bundle && npm run test:deployed && npm run test:unit",
    "test:deployed": "node --env-file=.env --import tsx --test \"test/*.test.ts\"",
    "test:unit": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:local": "PROXY_TARGET=local node --env-file=.env --import tsx --test \"test/*.test.ts\""
  },
  "keywords": [
    "aws",
    "lambda",
    "proxy",
    "streaming",
    "sigv4"
  ],
  "license": "MIT",
  "lambdaRuntime": {
    "runtime": "nodejs24.x",
    "providedSdkVersion": "3.1105.0"
  },
  "peerDependencies": {
    "@aws-sdk/credential-provider-node": ">=3",
    "@smithy/core": ">=2",
    "@smithy/protocol-http": ">=4",
    "@smithy/signature-v4": ">=4"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/credential-provider-node": {
      "optional": true
    },
    "@smithy/core": {
      "optional": true
    },
    "@smithy/protocol-http": {
      "optional": true
    },
    "@smithy/signature-v4": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "3.1105.0",
    "@aws-sdk/client-bedrock-runtime": "3.1105.0",
    "@aws-sdk/client-s3": "3.1105.0",
    "@aws-sdk/credential-provider-node": "3.972.84",
    "@eslint/js": "9.39.5",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@smithy/core": "3.35.2",
    "@smithy/node-http-handler": "4.12.1",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "@smithy/types": "4.19.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.9",
    "rollup": "4.64.3",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-esbuild": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
